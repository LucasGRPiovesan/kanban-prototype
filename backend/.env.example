# ----------------------------------------------------------------------------
# Copie para .env e ajuste conforme o ambiente.
#   cp .env.example .env
# Ao subir via Docker Compose, o compose já define estes valores.
# Deploy na Vercel + Aiven: veja docs/DEPLOY.md.
# ----------------------------------------------------------------------------

NODE_ENV=development
PORT=3333

# MySQL 8. Com Docker Compose, o host é o nome do serviço ("mysql").
# Serverless (Vercel): limite o pool por instância, ex.: ?connection_limit=5
DATABASE_URL="mysql://kanban:kanban@localhost:3306/kanban"
# Opcional — CA do MySQL gerenciado que exige TLS verificado (Aiven): conteúdo PEM ou
# base64. Quando presente, a conexão usa sslaccept=strict com esse certificado.
# DATABASE_CA_CERT=

# Mínimo de 32 caracteres. GERE UM VALOR PRÓPRIO EM PRODUÇÃO:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Também deriva a chave que cifra a chave de API do assistente de IA: ao trocá-lo,
# a chave cadastrada na tela precisa ser cadastrada de novo (docs/ADDED_REQUIREMENTS.md#39).
JWT_SECRET="troque-este-valor-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN=12h
AUTH_COOKIE_NAME=kanban_session
# lax (padrão) quando o frontend acessa a API no mesmo site (Docker, rewrite da Vercel).
# none só para API servida de outro site — exige AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SAMESITE=lax
# Padrão: true em produção, false fora dela.
# AUTH_COOKIE_SECURE=true
# Quantos proxies reversos há na frente da API (define o IP usado no rate limit).
TRUST_PROXY=1

# Validade do token da API de integração (requisito adicionado) — deliberadamente
# curta; ver docs/ADDED_REQUIREMENTS.md#36.
INTEGRATION_TOKEN_EXPIRES_IN=1h

# Fuso do calendário do negócio (IANA). Define "hoje" e o que está atrasado na
# Dashboard — ver docs/ADDED_REQUIREMENTS.md#38.
APP_TIMEZONE=America/Sao_Paulo

# Origens permitidas (separadas por vírgula) — precisa bater com o frontend.
# Também é a lista usada pela proteção CSRF (verificação do header Origin).
CORS_ORIGIN=http://localhost:5173

# Armazenamento de anexos.
#   local       — grava em disco e serve em /files (Docker, desenvolvimento)
#   vercel-blob — Vercel Blob (obrigatório na Vercel, cujo disco é efêmero)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3333/files
# Com STORAGE_DRIVER=vercel-blob:
# - Na Vercel: conecte o Blob store ao projeto. A Vercel adiciona BLOB_STORE_ID e o SDK
#   autentica por OIDC (token de curta duração por requisição). Nada a copiar.
# BLOB_STORE_ID=store_xxxxxxxxxxxxxxxx
# - Fora da Vercel (Docker, CI), uma das duas credenciais:
#   * VERCEL_OIDC_TOKEN, gravado por `vercel env pull` (expira; rode de novo quando vencer);
#   * BLOB_READ_WRITE_TOKEN, token estático do store. Não defina na Vercel.
# VERCEL_OIDC_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# Opcional; derivada de BLOB_STORE_ID (ou do token) quando ausente:
# BLOB_PUBLIC_BASE_URL=https://<store-id>.public.blob.vercel-storage.com

# Na Vercel, sem valor definido, vale 4; acima de 4,5 é recusado (limite do corpo da requisição).
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES_PER_REQUEST=10

# Stream de notificações (SSE): duração máxima antes de o servidor encerrar e o
# navegador reconectar (0 = sem limite), e intervalo da verificação no banco que entrega
# notificações geradas por outra instância. Na Vercel, sem valor definido, valem 240 e 5;
# duração 0 ou >= 300 s é recusada (limite da função).
NOTIFICATION_STREAM_MAX_SECONDS=1800
NOTIFICATION_POLL_INTERVAL_SECONDS=15

# Swagger UI em /docs e especificação em /openapi.json.
API_DOCS_ENABLED=true

LOG_FORMAT=dev

# Somente seed: chave do Gemini gravada (cifrada) na primeira execução em banco novo.
# SEED_ASSISTANT_API_KEY=

# Somente build da Vercel. Migrations e seed rodam apenas em Production (Preview nunca
# toca o banco); false/0/off pula a seed e mantém as migrations.
# SEED_ON_DEPLOY=true
