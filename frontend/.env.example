# URL base da API. Precisa incluir o prefixo de versão.
# Desenvolvimento local / Docker: a API em outra porta do mesmo host.
# Vercel: NÃO defina — o padrão "/api/v1" usa a rewrite de mesma origem do vercel.json
# (defina API_ORIGIN no projeto da Vercel; veja docs/DEPLOY.md).
VITE_API_BASE_URL=http://localhost:3333/api/v1
