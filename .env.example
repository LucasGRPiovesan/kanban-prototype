# -----------------------------------------------------------------------------
# Variáveis lidas pelo docker-compose.yml (copie para .env na raiz do repositório).
#   cp .env.example .env
# O arquivo .env é ignorado pelo Git — segredos nunca entram no repositório.
# -----------------------------------------------------------------------------

# Chave da API do Google Gemini usada pelo assistente de IA ("Ação rápida").
# Lida apenas pela seed ao criar a configuração pela primeira vez (banco novo).
# Sem ela, o assistente é criado sem chave e pode ser configurado pela tela.
SEED_ASSISTANT_API_KEY=

# Opcional: segredo JWT do ambiente Docker local (mínimo 32 caracteres).
# JWT_SECRET=
